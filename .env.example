# ─────────────────────────────────────────────────────────────
# ZAQRON website — environment variables
# Copy to .env.local (development) or set in your hosting provider.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets in them.
# Everything is optional: features switch on only when configured.
# ─────────────────────────────────────────────────────────────

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://zaqron.com
NEXT_PUBLIC_LEGAL_NAME=                 # Registered company name, e.g. "Zaqron Technologies Pvt. Ltd."
NEXT_PUBLIC_ALLOW_INDEXING=true         # set to false on preview/staging deployments

# ── Contact details (rendered only when set) ──
NEXT_PUBLIC_CONTACT_EMAIL=hello@zaqron.com
NEXT_PUBLIC_PARTNERS_EMAIL=partners@zaqron.com
NEXT_PUBLIC_CAREERS_EMAIL=careers@zaqron.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ── Social profiles (only real profiles; empty = hidden) ──
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Booking (Cal.com or Calendly public booking URL, https only) ──
NEXT_PUBLIC_BOOKING_URL=

# ── Enquiry delivery (at least ONE channel is required for forms to accept submissions) ──
# CRM / automation webhook — HubSpot workflow, Zoho Flow, Make, Zapier, n8n or custom endpoint
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=                     # optional; signs payload as X-Zaqron-Signature (HMAC-SHA256 hex)
# Email notifications via Resend (https://resend.com) — sender domain must be verified in Resend
RESEND_API_KEY=
INQUIRY_TO_EMAIL=                       # comma-separated recipients
INQUIRY_FROM_EMAIL=                     # e.g. "Zaqron Website <website@zaqron.com>"

# ── Spam protection ──
# Cloudflare Turnstile (optional; honeypot + time-trap + rate limiting are always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared rate limiting across serverless instances (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_RATE_LIMIT=5                    # submissions per IP per 10 minutes
ALLOWED_ORIGINS=                        # extra allowed origins for the API, comma-separated hosts (e.g. www.zaqron.com)

# ── Analytics (nothing loads unless set) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=           # zaqron.com
GOOGLE_SITE_VERIFICATION=               # Search Console verification token

# ── Sanity CMS (optional; local content files are used when unset) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
SANITY_API_READ_TOKEN=                  # only for private datasets
